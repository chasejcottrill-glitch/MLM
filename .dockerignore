# Railway/Railpack production image only needs the hosted web/backend app.
# Railpack detects nested package.json files before applying exclusions, so keep
# desktop/package.json available for plan resolution while excluding the actual
# Windows Electron payload from the Linux production image.
desktop/**
!desktop/package.json

# Local/build artifacts and metadata
**/node_modules
.git
.github
*.log
.env
.env.*
