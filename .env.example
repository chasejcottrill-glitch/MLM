# Apple Developer Program MusicKit key
APPLE_MUSICKIT_KEY_ID=
APPLE_MUSICKIT_TEAM_ID=
APPLE_MUSICKIT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Optional but recommended for web developer tokens.
# Comma-separated exact origins, e.g. https://your-app.up.railway.app
MUSICKIT_ALLOWED_ORIGINS=

# Optional Genre Guru acoustic adjudication.
# Genre Guru's /analyze endpoint accepts the Anthropic key as multipart api_key.
# Keep this server-side in Railway; never expose it to the browser bundle.
GENREGURU_ANTHROPIC_API_KEY=

# Performance controls for bulk library classification.
# Keep external acoustic calls modest; duplicate requests are deduplicated in-process.
GENREGURU_MAX_CONCURRENT=2
# Default: 90 days. Acoustic classification is cached by ISRC where available.
GENREGURU_CACHE_TTL_MS=7776000000
GENREGURU_MAX_CACHE_ENTRIES=10000
